{
  "name": "optimalx",
  "version": "1.0.0",
  "description": "optimalx - a Salla React theme",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:fresh": "node -e \"fs.rmSync('node_modules/.vite',{recursive:true,force:true})\" && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:copy": "node scripts/check-copy.mjs",
    "i18n:merge": "node scripts/i18n-merge.mjs",
    "check:jsonld": "node scripts/check-jsonld.mjs tests/fixtures/jsonld/*.json",
    "check:rtl": "node scripts/check-rtl.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:strings": "node scripts/check-strings.mjs",
    "check:all": "pnpm check:copy && pnpm check:jsonld && pnpm check:rtl && pnpm check:motion && pnpm check:strings",
    "gen:salla-ids": "node scripts/gen-salla-ids.mjs",
    "snapshot:store": "node scripts/snapshot-store.mjs",
    "serve:store": "node scripts/serve-store.mjs",
    "preview:offline": "node scripts/preview-offline.mjs"
  },
  "dependencies": {
    "@salla.sa/twilight-components-react": "^3.0.0-beta.1",
    "@salla.sa/twilight-theme-engine": "^1.0.0",
    "@tanstack/react-query": "~5.101.4",
    "@tanstack/react-router": "~1.170.31",
    "@tanstack/react-start": "~1.168.48",
    "@tanstack/virtual-file-routes": "~1.162.0",
    "@uidotdev/usehooks": "^2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@salla.sa/twilight-tailwind-theme": "^3.0.0-beta.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/react-router-devtools": "~1.167.1",
    "@tanstack/router-plugin": "~1.168.34",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "~6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "esbuild": "0.28.2",
    "jsdom": "^30.0.1",
    "postcss": "8.5.28",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.103.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "@tanstack/react-query-devtools": "~5.101.4"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
